# Force LF line endings for all text files, regardless of the
# contributor's OS or editor settings. CRLF line endings break Bash's
# parser on Linux ("syntax error near unexpected token"), so .sh
# files must always be stored with LF.
* text=auto eol=lf

*.sh text eol=lf
*.md text eol=lf
*.conf text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
